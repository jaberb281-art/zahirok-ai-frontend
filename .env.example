# AI Music API key (server-only). Create at https://aimusicapi.ai
AIMUSICAPI_KEY=

# Supabase PostgreSQL connection string (server-only)
DATABASE_URL=

# Supabase project URL (server-only)
SUPABASE_URL=

# Supabase service role key (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Launch mode: set to false to expose the full application during development
SUROZ_LAUNCH_MODE=true
NEXT_PUBLIC_SUROZ_LAUNCH_MODE=true
