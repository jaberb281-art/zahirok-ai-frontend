generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationJobStatus {
  queued
  generating
  succeeded
  failed
  cancelled
}

enum SongStatus {
  completed
  failed
  archived
}

enum SongVisibility {
  private
  public
}

model GenerationJob {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String?             @map("user_id") @db.Uuid
  deviceId             String?             @map("device_id")
  status               GenerationJobStatus
  provider             String
  providerTaskId       String?             @unique @map("provider_task_id")
  errorCode            String?             @map("error_code")
  errorMessage         String?             @map("error_message")
  prompt               String
  lyrics               String              @default("")
  title                String              @default("")
  tags                 String              @default("")
  instrumental         Boolean             @default(false)
  requestedDurationSec Int?                @map("requested_duration_sec")
  providerDurationSec  Decimal?            @map("provider_duration_sec") @db.Decimal(10, 2)
  creditsCharged       Int?                @map("credits_charged")
  startedAt            DateTime?           @map("started_at")
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  song Song?

  @@index([userId, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("generation_jobs")
}

model Song {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String?        @map("user_id") @db.Uuid
  deviceId             String?        @map("device_id")
  generationJobId      String?        @unique @map("generation_job_id") @db.Uuid
  title                String
  description          String         @default("")
  prompt               String
  lyrics               String         @default("")
  tags                 String         @default("")
  language             String?
  instrumental         Boolean        @default(false)
  bpm                  Int?
  musicKey             String?        @map("music_key")
  requestedDurationSec Int?           @map("requested_duration_sec")
  durationSec          Decimal?       @map("duration_sec") @db.Decimal(10, 2)
  status               SongStatus     @default(completed)
  visibility           SongVisibility @default(private)
  audioStorageKey      String         @map("audio_storage_key")
  audioMimeType        String         @map("audio_mime_type")
  audioByteSize        BigInt         @map("audio_byte_size")
  provider             String
  providerTaskId       String?        @map("provider_task_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([providerTaskId])
  @@map("songs")
}

model EarlyAccessSubmission {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  creatorTypes     String[] @map("creator_types")
  languages        String[]
  interests        String[]
  currentWorkflow  String   @map("current_workflow")
  runsMusicChannel String   @map("runs_music_channel")
  channelUrl       String?  @map("channel_url")
  socialUrl        String?  @map("social_url")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("early_access_submissions")
}
